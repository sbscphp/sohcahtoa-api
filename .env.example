# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database - Single unified database
DATABASE_URL=postgresql://postgres:password@localhost:5432/sochatoa_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@sochatoa.com
SMTP_FROM_NAME=Sochatoa API

# API Configuration
CORS_ORIGIN=*
API_BASE_URL=http://localhost:3000

# SMS Configuration (Optional - Termii)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=Sochatoa
