# ==============================================
# SOCHATOA API - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!
# ==============================================

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=sochatoa-api-monolith

# Database Configuration
# Note: When using Docker Compose, DATABASE_URL is overridden to use Docker service names
# For local development or server deployment outside Docker, set this to your database URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/sochatoa_db?schema=public

# Redis Configuration
# Note: When using Docker Compose, REDIS_URL is overridden to use Docker service names
# For local development or server deployment outside Docker, set this to your Redis URL
REDIS_URL=redis://localhost:6379

# JWT Secrets
# IMPORTANT: Generate strong random secrets for production!
# You can use: openssl rand -base64 32
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
MOBILE_ACCESS_TOKEN_EXPIRY=1d
ACCESS_TOKEN_EXPIRY=1d

# SMTP Configuration (Email)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=your-email@gmail.com
SMTP_PASS=true

# API Configuration
CORS_ORIGIN=*
API_BASE_URL=http://localhost:3000
API_BASE_PATH=

# SMS Configuration (Termii)
# Uncomment and fill in if you want to enable SMS notifications
# TERMII_API_KEY=your-termii-api-key
# TERMII_SENDER_ID=Sochatoa

# Cloudinary Configuration (Document Uploads)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name

# Providus Bank Configuration (Virtual Account Provider)
# Get these credentials from Providus Bank
PROVIDUS_BASE_URL=http://154.113.16.142:8088/appdevapi/api
PROVIDUS_CLIENT_ID=your-providus-client-id
PROVIDUS_CLIENT_SECRET=your-providus-client-secret

# Firebase Configuration (Push Notifications)
# Paste the entire Firebase service account JSON as a single-line string
# Get this from Firebase Console > Project Settings > Service Accounts
# Example: FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project",...}'
FIREBASE_SERVICE_ACCOUNT=

# QoreID Configuration (Passport/ID Verification for Tourist & Expatriate signup)
# Get these from your QoreID dashboard
QOREID_BASE_URL=https://api.qoreid.com
QOREID_CLIENT_ID=your-qoreid-client-id
QOREID_SECRET=your-qoreid-secret
# Optional: override the passport verification endpoint (default: /v1/ng/passport)
# QOREID_PASSPORT_ENDPOINT=/v1/ng/passport

# OTP visibility in API responses
# Set to 'production' to strip OTPs from all responses (codes delivered via email/SMS only)
OTP_RELEASE=

# Frontend URL (used to build receipt links and refund form deep links in emails)
APP_URL=https://your-frontend-domain.com

# Support contact info (shown in email footers)
SUPPORT_PHONE=+234XXXXXXXXXX
SUPPORT_AGENT_NAME=Support Team

# Termii Email Template IDs
# Upload each HTML file from /templates/email/ to the Termii dashboard,
# then paste the generated template ID for each one below.
#
# Shared variables sent with every template:
#   first_name, recipient_email, company_name, company_address, current_year,
#   app_url, support_email, support_phone, support_agent_name,
#   unsubscribe_url, preferences_url, x_url, facebook_url, instagram_url
#
# ── OTP templates ──────────────────────────────────────────────────────────
#   Variables: otp_digit_1 … otp_digit_6, expiry_minutes
TERMII_TEMPLATE_ID_VERIFY_EMAIL_OTP=
TERMII_TEMPLATE_ID_RESET_PASSWORD_OTP=
#
# ── Settled / completed (one per transaction type) ────────────────────────
#   PTA / BTA: transaction_id, amount_display, bank_name, account_number,
#              branch_name, street_address, city_state, receipt_url
TERMII_TEMPLATE_ID_PTA_FUNDS_REMITTED=
TERMII_TEMPLATE_ID_BTA_FUNDS_REMITTED=
#   School / Medical / Professional Body: transaction_id, amount_display,
#              beneficiary_name, beneficiary_account, disbursement_date, receipt_url
TERMII_TEMPLATE_ID_SCHOOL_FEE_DISBURSED=
TERMII_TEMPLATE_ID_MEDICAL_FEE_DISBURSED=
TERMII_TEMPLATE_ID_PROFESSIONAL_BODY_DISBURSED=
#   Tourist: transaction_id, branch_name, street_address, city_state, pickup_date, receipt_url
TERMII_TEMPLATE_ID_TOURIST_CARD_PICKUP=
#
# ── Refund bank details request ────────────────────────────────────────────
#   Variables: transaction_id, transaction_type_label, refund_amount_display,
#              provide_bank_details_url
TERMII_TEMPLATE_ID_REFUND_BANK_DETAILS_REQUEST=
#
# ── Legacy templates (no new design yet — keep IDs until redesign is complete) ──
TERMII_TEMPLATE_ID_TRANSACTION_APPROVED=
TERMII_TEMPLATE_ID_TRANSACTION_REJECTED=
TERMII_TEMPLATE_ID_DEPOSIT_CONFIRMED=
TERMII_TEMPLATE_ID_WELCOME=
TERMII_TEMPLATE_ID_AGENT_WELCOME=
TERMII_TEMPLATE_ID_ADMIN_WELCOME=
TERMII_TEMPLATE_ID_PASSWORD_RESET_CONFIRM=
TERMII_TEMPLATE_ID_PASSWORD_CREATION=
TERMII_TEMPLATE_ID_KYC_APPROVED=
TERMII_TEMPLATE_ID_KYC_REJECTED=
TERMII_TEMPLATE_ID_ACCOUNT_SUSPENDED=
TERMII_TEMPLATE_ID_ACCOUNT_ACTIVATED=
TERMII_TEMPLATE_ID_ADDITIONAL_INFO_REQUIRED=
TERMII_TEMPLATE_ID_DOCUMENT_APPROVED=
TERMII_TEMPLATE_ID_DOCUMENT_REJECTED=
