generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  COMPLIANCE_OFFICER
  OPERATIONS
  SUPER_ADMIN
}

enum ActionType {
  TRANSACTION_APPROVE
  TRANSACTION_REJECT
  DEPOSIT_CONFIRM
  DOCUMENT_APPROVE
  DOCUMENT_REJECT
  COMPLIANCE_REVIEW
  USER_SUSPEND
  USER_ACTIVATE
  LIMITS_OVERRIDE
  CASH_PICKUP_ISSUE
  PREPAID_CARD_ISSUE
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  permissions Json     @default("[]") // Array of permission strings
  branch      String? 
  department  String?  
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       AdminUser[]

  @@map("roles")
}

model AdminUser {
  id            String     @id @default(uuid())
  email         String     @unique
  fullName      String
  phoneNumber   String
  altPhoneNumber String?
  position      String?
  departmentName String?
  branch        String
  password      String?
  
  // Relations
  roleId        String?
  roleDef       Role?      @relation(fields: [roleId], references: [id])

  departmentId    String?

  department      Department? @relation(fields: [departmentId], references: [id])

  
  // Backward compatibility (deprecated)
  role          AdminRole?
  permissions   Json?

  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  actions       AdminAction[]
  assignments   TaskAssignment[]
  tokens        Token[]

  @@index([email])
  @@index([roleId])
  @@map("admin_users")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  departmentEmail String?
  description String?
  branch      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       AdminUser[]
  actions     AdminAction[]

  @@map("departments")
} 

model AdminAction {
  id              String     @id @default(uuid())
  adminId         String
  actionType      ActionType
  resourceType    String
  resourceId      String
  previousState   Json?
  newState        Json?
  reason          String?
  metadata        Json?
  performedAt     DateTime   @default(now())
  ipAddress       String?
  userAgent       String?

  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  admin           AdminUser  @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([resourceType, resourceId])
  @@index([actionType])
  @@map("admin_actions")
}

model TaskAssignment {
  id            String      @id @default(uuid())
  adminId       String
  taskType      String
  taskId        String
  priority      Int         @default(1)
  status        String      @default("PENDING")
  assignedAt    DateTime    @default(now())
  completedAt   DateTime?
  notes         String?

  admin         AdminUser   @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([status])
  @@index([priority])
  @@map("task_assignments")
}

model Dashboard {
  id                    String   @id @default(uuid())
  date                  DateTime @default(now())
  totalTransactions     Int      @default(0)
  pendingApprovals      Int      @default(0)
  completedTransactions Int      @default(0)
  rejectedTransactions  Int      @default(0)
  totalVolume           Decimal  @db.Decimal(18, 2)
  amlFlags              Int      @default(0)
  pendingReviews        Int      @default(0)
  metadata              Json?

  @@index([date])
  @@map("dashboards")
}

model OutboxEvent {
  id            String   @id
  eventType     String
  source        String
  aggregateId   String
  payload       Json
  status        String   @default("PENDING") // PENDING | PUBLISHED | FAILED
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  publishedAt   DateTime?
}

enum TokenType {
  OTP
  PASSWORD_RESET
  EMAIL_VERIFICATION
  MAGIC_LINK
  REFRESH
}

model Token {
  id          String    @id @default(uuid())
  userId      String
  type        TokenType
  token       String    @unique
  expiresAt   DateTime
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([type])
  @@index([expiresAt])
  @@map("tokens")
}


enum AmlFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AmlFlagType {
  THRESHOLD_EXCEEDED
  SUSPICIOUS_PATTERN
  HIGH_RISK_COUNTRY
  FREQUENT_TRANSACTIONS
  STRUCTURING
  POLITICALLY_EXPOSED_PERSON
  SANCTIONS_LIST
  ADVERSE_MEDIA
}

enum CustomerFlagStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model CustomerFlag {
  id          String             @id @default(uuid())
  userId      String             
  type        AmlFlagType
  severity    AmlFlagSeverity
  status      CustomerFlagStatus @default(OPEN)

  title       String?
  description String
  details     Json?

  createdBy   String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  resolvedAt  DateTime?
  resolvedBy  String?
  resolutionNotes String?

  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([userId])
  @@map("customer_flags")
}
