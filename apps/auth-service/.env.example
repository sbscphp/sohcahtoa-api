NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:password@localhost:5432/auth_db?schema=public"

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-service
KAFKA_GROUP_ID=auth-service-group

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=FX Platform <noreply@fxplatform.com>

# External APIs
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=FXPlatform
CBN_TRMS_API_URL=https://api.cbn.gov.ng/trms
CBN_TRMS_API_KEY=your-cbn-api-key

# Service URLs
API_GATEWAY_URL=http://localhost:3000
DOCUMENT_SERVICE_URL=http://localhost:3003
