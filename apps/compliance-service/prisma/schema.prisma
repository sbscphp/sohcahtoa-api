generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AmlCheckStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FLAGGED
  FAILED
}

enum AmlFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AmlFlagType {
  THRESHOLD_EXCEEDED
  SUSPICIOUS_PATTERN
  HIGH_RISK_COUNTRY
  FREQUENT_TRANSACTIONS
  STRUCTURING
  POLITICALLY_EXPOSED_PERSON
  SANCTIONS_LIST
  ADVERSE_MEDIA
}

enum ComplianceReviewStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  REQUIRES_MORE_INFO
}

model AmlCheck {
  id              String          @id @default(uuid())
  transactionId   String
  userId          String
  amount          Decimal         @db.Decimal(18, 2)
  currency        String
  transactionType String
  sourceOfFunds   String?
  status          AmlCheckStatus  @default(PENDING)
  riskScore       Int             @default(0)
  recommendations Json?
  checkedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  flags           AmlFlag[]
  reviews         ComplianceReview[]

  @@index([transactionId])
  @@index([userId])
  @@index([status])
  @@map("aml_checks")
}

model AmlFlag {
  id          String           @id @default(uuid())
  checkId     String
  type        AmlFlagType
  severity    AmlFlagSeverity
  description String
  details     Json?
  createdAt   DateTime         @default(now())

  check       AmlCheck         @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([severity])
  @@map("aml_flags")
}

model ComplianceReview {
  id          String                  @id @default(uuid())
  checkId     String
  transactionId String
  reviewerId  String
  status      ComplianceReviewStatus  @default(PENDING)
  notes       String?
  decision    String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  reviewedAt  DateTime?

  check       AmlCheck                @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([transactionId])
  @@index([reviewerId])
  @@index([status])
  @@map("compliance_reviews")
}

model WatchList {
  id          String   @id @default(uuid())
  name        String
  type        String
  reason      String
  source      String
  addedAt     DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  metadata    Json?

  @@index([name])
  @@index([type])
  @@index([isActive])
  @@map("watch_lists")
}

model NfiuReport {
  id              String   @id @default(uuid())
  transactionId   String
  userId          String
  reportType      String
  amount          Decimal  @db.Decimal(18, 2)
  currency        String
  reason          String
  reportData      Json
  reportedAt      DateTime @default(now())
  reportReference String   @unique

  @@index([transactionId])
  @@index([userId])
  @@map("nfiu_reports")
}
