generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  PTA
  BTA
  SCHOOL_FEES
  MEDICAL
  PROFESSIONAL_BODY
  TOURIST_FX
  RESIDENT_FX
  EXPATRIATE_FX
  IMTO_REMITTANCE
  CASH_REMITTANCE
}

enum TransactionStatus {
  DRAFT
  AWAITING_VERIFICATION
  VERIFICATION_IN_PROGRESS
  VERIFICATION_COMPLETED
  AWAITING_DEPOSIT
  DEPOSIT_PENDING
  DEPOSIT_CONFIRMED
  COMPLIANCE_REVIEW
  ADMIN_APPROVAL_PENDING
  APPROVED
  DISBURSEMENT_IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum TransactionStep {
  PERSONAL_INFO
  DOCUMENT_UPLOAD
  DOCUMENT_VERIFICATION
  AMOUNT_CALCULATION
  DEPOSIT_INFO
  DEPOSIT_CONFIRMATION
  COMPLIANCE_CHECK
  ADMIN_REVIEW
  DISBURSEMENT
}

enum DisbursementMethod {
  BANK_TRANSFER
  CASH_PICKUP
  PREPAID_CARD
  IMTO
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED
  REQUIRES_MANUAL_REVIEW
}

enum DocumentType {
  PASSPORT
  VISA
  TICKET
  RECEIPT
  INVOICE
  MEDICAL_LETTER
  PROFESSIONAL_BODY_LETTER
  BVN
  TIN
  UTILITY_BILL
  SCHOOL_ADMISSION
}

model Transaction {
  id                  String              @id @default(uuid())
  userId              String
  referenceNumber     String              @unique
  type                TransactionType
  status              TransactionStatus   @default(DRAFT)
  currentStep         TransactionStep     @default(PERSONAL_INFO)
  purpose             String
  destinationCountry  String
  currency            String
  foreignAmount       Decimal?            @db.Decimal(18, 2)
  nairaEquivalent     Decimal?            @db.Decimal(18, 2)
  exchangeRate        Decimal?            @db.Decimal(18, 6)
  disbursementMethod  DisbursementMethod?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  completedAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?

  steps               TransactionStepLog[]
  documents           TransactionDocument[]
  history             TransactionHistory[]
  cashPickup          CashPickup?
  prepaidCard         PrepaidCard?
  receipt             Receipt?

  @@index([userId])
  @@index([referenceNumber])
  @@index([status])
  @@index([type])
  @@map("transactions")
}

model TransactionStepLog {
  id            String          @id @default(uuid())
  transactionId String
  step          TransactionStep
  status        String
  data          Json?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())

  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_steps")
}

model TransactionDocument {
  id                 String             @id @default(uuid())
  transactionId      String
  documentType       DocumentType
  fileUrl            String
  fileName           String
  fileSize           Int
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?
  uploadedAt         DateTime           @default(now())
  metadata           Json?

  transaction        Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([verificationStatus])
  @@map("transaction_documents")
}

model TransactionHistory {
  id            String       @id @default(uuid())
  transactionId String
  action        String
  previousValue String?
  newValue      String?
  performedBy   String?
  notes         String?
  createdAt     DateTime     @default(now())
  metadata      Json?

  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_history")
}

model TransactionLimit {
  id                  String          @id @default(uuid())
  userId              String
  type                TransactionType
  quarterlyLimit      Decimal         @db.Decimal(18, 2)
  yearlyLimit         Decimal         @db.Decimal(18, 2)
  currentQuarterUsage Decimal         @default(0) @db.Decimal(18, 2)
  currentYearUsage    Decimal         @default(0) @db.Decimal(18, 2)
  quarter             Int
  year                Int
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([userId, type, quarter, year])
  @@index([userId])
  @@map("transaction_limits")
}

model CashPickup {
  id             String      @id @default(uuid())
  transactionId  String      @unique
  pickupLocation String
  pickupCode     String      @unique
  recipientName  String
  recipientPhone String
  amount         Decimal     @db.Decimal(18, 2)
  currency       String
  status         String      @default("PENDING")
  expiryDate     DateTime
  pickedUpAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([pickupCode])
  @@index([status])
  @@map("cash_pickup")
}

model PrepaidCard {
  id               String      @id @default(uuid())
  transactionId    String      @unique
  cardNumber       String      @unique
  cardType         String
  amount           Decimal     @db.Decimal(18, 2)
  currency         String
  expiryDate       DateTime
  cvv              String
  activationStatus String      @default("PENDING")
  activatedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([cardNumber])
  @@map("prepaid_cards")
}

model Receipt {
  id              String      @id @default(uuid())
  transactionId   String      @unique
  receiptNumber   String      @unique
  qrCode          String
  pdfUrl          String?
  generatedAt     DateTime    @default(now())
  metadata        Json?

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([receiptNumber])
  @@map("receipts")
}
