  description       String?
  type              String
  approvalType      ApprovalType           @default(TRANSACTION)
  minAmount         Decimal?               @db.Decimal(18, 2)
  maxAmount         Decimal?               @db.Decimal(18, 2)
  processType       WorkflowProcessType    @default(RIGID_LINEAR)
  action            String?
  branchId          String?
  branch            Branch?                @relation(fields: [branchId], references: [id])
  departmentId      String?
  department        Department?            @relation(fields: [departmentId], references: [id])
  escalationMinutes Int                    @default(0)
  hasPtaRequest     Boolean                @default(false)
  status            WorkflowTemplateStatus @default(ACTIVE)
  createdBy         String
  creator           AdminUser              @relation("WorkflowTemplateCreator", fields: [createdBy], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  stages            WorkflowStage[]
  exchangeRates     ExchangeRate[]
  walletEntries     WalletEntry[]

  @@index([status])
  @@index([departmentId])
  @@index([branchId])
  @@map("workflow_templates")
}

model WorkflowStage {
  id                String           @id @default(uuid())
  templateId        String
  template          WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name              String
  type              String?
  order             Int
  escalationMinutes Int              @default(0)
  createdAt         DateTime         @default(now())

  escalationAdminId String?
  escalationAdmin   AdminUser?       @relation("WorkflowStageEscalationAdmin", fields: [escalationAdminId], references: [id])
  assignees         WorkflowAssignee[]


  @@index([templateId])
  @@index([order])
  @@map("workflow_stages")
}

model WorkflowStageType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workflow_stage_types")
}

model WorkflowAssignee {
  id        String        @id @default(uuid())
  stageId   String
  stage     WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  adminId   String
  admin     AdminUser     @relation(fields: [adminId], references: [id])
  order     Int           @default(1)
  createdAt DateTime      @default(now())

  @@unique([stageId, adminId])
  @@index([stageId])
  @@index([adminId])
  @@map("workflow_assignees")
}
