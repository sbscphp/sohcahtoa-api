generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

// Auth & User Management
enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
  COMPLIANCE_OFFICER
  OPERATIONS
  SUPER_ADMIN
}

enum CustomerType {
  NIGERIAN_CITIZEN
  TOURIST
  EXPATRIATE
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  CHANGE_PASSWORD
  AGENT_SET_PASSWORD
  TRANSACTION_VERIFICATION
}

// Admin Service
enum AdminRole {
  ADMIN
  COMPLIANCE_OFFICER
  OPERATIONS
  SUPER_ADMIN
}

enum ActionType {
  TRANSACTION_APPROVE
  TRANSACTION_REJECT
  DEPOSIT_CONFIRM
  DOCUMENT_APPROVE
  DOCUMENT_REJECT
  COMPLIANCE_REVIEW
  USER_SUSPEND
  USER_ACTIVATE
  LIMITS_OVERRIDE
  CASH_PICKUP_ISSUE
  PREPAID_CARD_ISSUE
  AGENT_CREATE
  AGENT_UPDATE_STATUS
  AGENT_APPROVE
  AGENT_DEACTIVATE
  RATE_CREATE
  RATE_UPDATE
  RATE_DEACTIVATE
  REPORT_GENERATE
  ADMIN_USER_CREATE
  ADMIN_USER_UPDATE
  ADMIN_USER_ACTIVATE
  ADMIN_USER_SUSPEND
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  DEPARTMENT_CREATE
  DEPARTMENT_UPDATE
  DEPARTMENT_DELETE
}

enum TokenType {
  OTP
  PASSWORD_RESET
  EMAIL_VERIFICATION
  MAGIC_LINK
  REFRESH
}

enum CustomerFlagStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// Transaction Service
enum TransactionType {
  PTA
  BTA
  SCHOOL_FEES
  MEDICAL
  PROFESSIONAL_BODY
  TOURIST_FX
  RESIDENT_FX
  EXPATRIATE_FX
  IMTO_REMITTANCE
  CASH_REMITTANCE
}

enum TransactionMode {
  BUY
  SELL
}

enum TransactionStatus {
  DRAFT
  AWAITING_VERIFICATION
  VERIFICATION_IN_PROGRESS
  VERIFICATION_COMPLETED
  AWAITING_DEPOSIT
  DEPOSIT_PENDING
  DEPOSIT_CONFIRMED
  AWAITING_DISBURSEMENT
  COMPLIANCE_REVIEW
  ADMIN_APPROVAL_PENDING
  APPROVED
  DISBURSEMENT_IN_PROGRESS
  PENDING_RECORD_VALIDATION
  COMPLETED
  REJECTED
  CANCELLED
  AWAITING_REFUND_VERIFICATION
}

enum TransactionStep {
  PERSONAL_INFO
  DOCUMENT_UPLOAD
  DOCUMENT_VERIFICATION
  AMOUNT_CALCULATION
  DEPOSIT_INFO
  DEPOSIT_CONFIRMATION
  COMPLIANCE_CHECK
  ADMIN_REVIEW
  DISBURSEMENT
  REFUNDED
  COMPLETED
}

enum DisbursementMethod {
  BANK_TRANSFER
  CASH_PICKUP
  PREPAID_CARD
  IMTO
}

enum DisbursementOption {
  ELECTRONIC_TRANSFER // 100% bank transfer
  CARD                // 100% prepaid card
  CARD_AND_CASH       // 75% card + 25% cash (max $500 cash)
  CASH_AND_TRANSFER   // 25% cash + 75% electronic transfer (min cash balance gap: 500)
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED
  REJECTED
  REQUIRES_MANUAL_REVIEW
}

enum DocumentType {
  PASSPORT
  VISA
  TICKET
  RETURN_TICKET
  RECEIPT
  INVOICE
  MEDICAL_LETTER
  OVERSEAS_MEDICAL_LETTER
  PROFESSIONAL_BODY_LETTER
  BVN
  NIN
  TIN
  TCC
  UTILITY_BILL
  SCHOOL_ADMISSION
  STATEMENT_OF_RESULT
  DEGREE
  FORM_A_DOCUMENT
  CORPORATE_BODY_LETTER
  PARTNER_INVITATION_LETTER
  MEMBERSHIP_CARD
  WORK_PERMIT
  PROOF_OF_FUNDS
  SOURCE_OF_FUNDS_DECLARATION
  DIGITAL_SIGNATURE
  BANK_VERIFICATION
  STUDENT_PASSPORT
}

// Payment Service
enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CASH_DEPOSIT
}

// Compliance Service
enum AmlCheckStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FLAGGED
  FAILED
}

enum AmlFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AmlFlagType {
  THRESHOLD_EXCEEDED
  SUSPICIOUS_PATTERN
  HIGH_RISK_COUNTRY
  FREQUENT_TRANSACTIONS
  STRUCTURING
  POLITICALLY_EXPOSED_PERSON
  SANCTIONS_LIST
  ADVERSE_MEDIA
}

enum ComplianceReviewStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  REQUIRES_MORE_INFO
}

// Document Service
enum VerificationType {
  PASSPORT
  VISA
  BVN
  TIN
  TICKET
  INVOICE
  MEDICAL_LETTER
  SCHOOL_ADMISSION
  PROFESSIONAL_BODY_LETTER
}

// Audit Service
enum EventCategory {
  AUTHENTICATION
  TRANSACTION
  PAYMENT
  COMPLIANCE
  ADMIN
  SYSTEM
}

enum Severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ========================================
// AUTH SERVICE MODELS
// ========================================

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  phoneNumber      String        @unique
  role             UserRole      @default(CUSTOMER)
  customerType     CustomerType?
  createdByAgentId String?
  isActive         Boolean       @default(true)
  emailVerified    Boolean       @default(false)
  phoneVerified    Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  credentials    UserCredential?
  profile        UserProfile?
  kyc            UserKyc?
  sessions       Session[]
  otpLogs        OtpLog[]
  tickets        Ticket[]           @relation("TicketCustomer")
  createdByAgent Agent?             @relation("AgentCreatedCustomers", fields: [createdByAgentId], references: [id])
  transactions   Transaction[]      @relation("UserTransactions")
  bankAccounts   CustomerBankAccount[] @relation("UserBankAccounts")

  @@index([email])
  @@index([phoneNumber])
  @@index([customerType])
  @@index([createdByAgentId])
  @@map("users")
}

model UserCredential {
  id                 String    @id @default(uuid())
  userId             String    @unique
  passwordHash       String
  lastPasswordChange DateTime  @default(now())
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  address     String?
  city        String?
  state       String?
  country     String    @default("Nigeria")
  postalCode  String?
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserKyc {
  id                  String    @id @default(uuid())
  userId              String    @unique
  status              KycStatus @default(NOT_STARTED)
  bvn                 String?   @unique
  nin                 String?   @unique
  tin                 String?
  passportNumber      String?
  passportDocumentUrl String?
  passportIssueDate   DateTime?
  passportExpiryDate  DateTime?
  bvnVerified         Boolean   @default(false)
  ninVerified         Boolean   @default(false)
  tinVerified         Boolean   @default(false)
  passportVerified    Boolean   @default(false)
  verificationNotes   String?
  verifiedAt          DateTime?
  verifiedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bvn])
  @@index([nin])
  @@map("user_kyc")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model OtpLog {
  id          String     @id @default(uuid())
  userId      String?
  email       String?
  phoneNumber String?
  otp         String
  purpose     OtpPurpose
  isUsed      Boolean    @default(false)
  attempts    Int        @default(0)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phoneNumber])
  @@index([expiresAt])
  @@map("otp_logs")
}

// ========================================
// ADMIN SERVICE MODELS
// ========================================

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  permissions Json    @default("[]")

  branch       String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           AdminUser[]
  rolePermissions RolePermission[]
  createdBy       String?
  createdById     String?

  @@index([departmentId])
  @@map("roles")
}

model Permission {
  id         String  @id @default(uuid())
  module     String
  featureKey String
  action     String // e.g. VIEW | EDIT | CREATE | UPDATE | DELETE | EXPORT
  label      String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleLinks RolePermission[]

  @@unique([module, featureKey, action])
  @@index([module, featureKey, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AdminUser {
  id             String  @id @default(uuid())
  sequenceId     Int     @default(autoincrement()) @unique
  email          String  @unique
  fullName       String
  phoneNumber    String
  altPhoneNumber String?
  position       String?
  branch         String
  password       String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  permissions Json?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions                  AdminAction[]
  assignments              TaskAssignment[]
  tokens                   Token[]
  assignedTickets          Ticket[]           @relation("TicketAssignedAgent")
  ticketComments           TicketComment[]    @relation("TicketCommentAdmin")
  ticketsCreated           Ticket[]           @relation("TicketCreatedByAdmin")
  createdWorkflowTemplates WorkflowTemplate[] @relation("WorkflowTemplateCreator")
  workflowAssignees        WorkflowAssignee[]
  escalatedStages          WorkflowStage[]    @relation("WorkflowStageEscalationAdmin")


  @@index([email])
  @@index([roleId])
  @@index([departmentId])
  @@map("admin_users")
}

model Department {
  id              String  @id @default(uuid())
  name            String  @unique
  departmentEmail String?
  description     String?
  branch          String

  isDefault       Boolean    @default(false)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy   String?
  createdById String?

  users             AdminUser[]
  actions           AdminAction[]
  roles             Role[]
  workflowTemplates WorkflowTemplate[]

  @@map("departments")
}

model Franchise {
  id                String   @id @default(uuid())
  name              String
  state             String
  address           String
  contactPersonName String
  email             String
  phoneNumber       String
  altPhoneNumber    String?
  status            String   @default("PENDING")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branches Branch[]

  @@index([name])
  @@index([status])
  @@map("franchises")
}

model Branch {
  id               String   @id @default(uuid())
  franchiseId      String?
  name             String
  branchEmail      String?
  state            String
  address          String
  branchManager    String
  email            String
  phoneNumber      String
  agentName        String?
  agentEmail       String?
  agentPhoneNumber String?
  status           String   @default("PENDING")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  agents    Agent[]
  workflowTemplates WorkflowTemplate[]

  @@unique([franchiseId, name])
  @@index([franchiseId])
  @@index([status])
  @@map("branches")
}

model PickupStation {
  id          String   @id @default(uuid())
  name        String
  email       String
  phoneNumber String
  state       String
  region      String
  address     String
  status      String   @default("PENDING")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([state])
  @@index([region])
  @@index([status])
  @@map("pickup_stations")
}

model Agent {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phoneNumber String   @unique
  password    String?
  isActive    Boolean  @default(false)
  isApproved  Boolean  @default(false)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments      AgentAttachment[]
  createdCustomers User[]            @relation("AgentCreatedCustomers")
  createdTransactions Transaction[] @relation("AgentCreatedTransactions")
  createdTickets   Ticket[]        @relation("TicketCreatedByAgent")


  @@index([branchId])
  @@index([name])
  @@map("agents")
}

model AgentAttachment {
  id        String   @id @default(uuid())
  agentId   String
  fileUrl   String
  fileName  String?
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_attachments")
}

model AdminAction {
  id            String     @id @default(uuid())
  adminId       String
  actionType    String?
  actionLabel   String?
  resourceType  String
  resourceId    String
  previousState Json?
  newState      Json?
  reason        String?
  metadata      Json?
  performedAt   DateTime   @default(now())
  ipAddress     String?
  userAgent     String?
  status        String     @default("SUCCESS")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([resourceType, resourceId])
  @@index([actionType])
  @@map("admin_actions")
}

model TaskAssignment {
  id          String    @id @default(uuid())
  adminId     String
  taskType    String
  taskId      String
  priority    Int       @default(1)
  status      String    @default("PENDING")
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  notes       String?

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([status])
  @@index([priority])
  @@map("task_assignments")
}

model Dashboard {
  id                    String   @id @default(uuid())
  date                  DateTime @default(now())
  totalTransactions     Int      @default(0)
  pendingApprovals      Int      @default(0)
  completedTransactions Int      @default(0)
  rejectedTransactions  Int      @default(0)
  totalVolume           Decimal  @db.Decimal(18, 2)
  amlFlags              Int      @default(0)
  pendingReviews        Int      @default(0)
  metadata              Json?

  @@index([date])
  @@map("dashboards")
}

model OutboxEvent {
  id          String    @id
  eventType   String
  source      String
  aggregateId String
  payload     Json
  status      String    @default("PENDING")
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@map("outbox_events")
}

model Token {
  id          String    @id @default(uuid())
  userId      String
  type        TokenType
  token       String    @unique
  expiresAt   DateTime
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  metadata    Json?
  createdAt   DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([type])
  @@index([expiresAt])
  @@map("tokens")
}

model CustomerFlag {
  id       String             @id @default(uuid())
  userId   String
  type     AmlFlagType
  severity AmlFlagSeverity
  status   CustomerFlagStatus @default(OPEN)

  title       String?
  description String
  details     Json?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?

  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([userId])
  @@map("customer_flags")
}

enum EscrowAccountStatus {
  ACTIVE
  INACTIVE
}

model EscrowAccount {
  id            String             @id @default(uuid())
  currency      String             @default("NGN - Naira")
  bankName      String
  accountNumber String
  accountName   String
  status        EscrowAccountStatus @default(ACTIVE)
  createdBy     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([accountNumber])
  @@index([status])
  @@map("escrow_accounts")
}

// ========================================
// TRANSACTION SERVICE MODELS
// ========================================

model Transaction {
  id                 String              @id @default(uuid())
  userId             String
  createdByAgentId   String?
  referenceNumber    String              @unique
  type               TransactionType
  transactionMode    TransactionMode?    @map("transaction_mode")
  status             TransactionStatus   @default(DRAFT)
  currentStep        TransactionStep     @default(PERSONAL_INFO)
  purpose            String
  destinationCountry String?
  currency           String
  foreignAmount      Decimal?            @db.Decimal(18, 2)
  formAId            String?
  nairaEquivalent    Decimal?            @db.Decimal(18, 2)
  exchangeRate       Decimal?            @db.Decimal(18, 6)
  amountPaid         Decimal?            @db.Decimal(18, 2) // Cumulative amount received so far
  balanceDue         Decimal?            @db.Decimal(18, 2) // Positive = underpaid (still owed), Negative = overpaid (credit)
  disbursementMethod DisbursementMethod?
  disbursementOption DisbursementOption?
  taxClearanceNumber String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  completedAt        DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?

  workflowTemplateId String?
  currentWorkflowStageId String?

  createdByAgent Agent?              @relation("AgentCreatedTransactions", fields: [createdByAgentId], references: [id])
  user           User                @relation("UserTransactions", fields: [userId], references: [id])
  steps       TransactionStepLog[]
  documents   TransactionDocument[]
  history     TransactionHistory[]
  cashPickup   CashPickup?
  prepaidCard  PrepaidCard?
  receipt      Receipt?
  settlement   Settlement?
  bankAccounts TransactionBankAccount[]

  @@index([userId])
  @@index([createdByAgentId])
  @@index([referenceNumber])
  @@index([status])
  @@index([type])
  @@index([transactionMode])
  @@index([disbursementOption])
  @@map("transactions")
}

// Customer's own bank accounts — reusable across transactions
model CustomerBankAccount {
  id            String   @id @default(uuid())
  userId        String
  bankName      String
  accountNumber String
  accountName   String
  currency      String?  // e.g. NGN, USD, GBP — null/NGN = regular; any foreign currency = domiciliary
  isVerified    Boolean  @default(false) // true once name was confirmed via lookup
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User                     @relation("UserBankAccounts", fields: [userId], references: [id])
  transactions TransactionBankAccount[]

  @@unique([userId, accountNumber])
  @@index([userId])
  @@map("customer_bank_accounts")
}

// Join table: which bank accounts are attached to a specific transaction
model TransactionBankAccount {
  id                    String   @id @default(uuid())
  transactionId         String
  customerBankAccountId String
  createdAt             DateTime @default(now())

  transaction  Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bankAccount  CustomerBankAccount @relation(fields: [customerBankAccountId], references: [id], onDelete: Cascade)

  @@unique([transactionId, customerBankAccountId])
  @@index([transactionId])
  @@map("transaction_bank_accounts")
}

model TransactionStepLog {
  id            String          @id @default(uuid())
  transactionId String
  step          TransactionStep
  status        String
  data          Json?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_steps")
}

model TransactionDocument {
  id                 String             @id @default(uuid())
  transactionId      String
  documentType       DocumentType
  fileUrl            String
  fileName           String
  fileSize           Int
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?
  uploadedAt         DateTime           @default(now())
  metadata           Json?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([verificationStatus])
  @@map("transaction_documents")
}

model TransactionHistory {
  id            String   @id @default(uuid())
  transactionId String
  action        String
  previousValue String?
  newValue      String?
  performedBy   String?
  notes         String?
  createdAt     DateTime @default(now())
  metadata      Json?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_history")
}

model TransactionLimit {
  id                  String          @id @default(uuid())
  userId              String
  type                TransactionType
  quarterlyLimit      Decimal         @db.Decimal(18, 2)
  yearlyLimit         Decimal         @db.Decimal(18, 2)
  currentQuarterUsage Decimal         @default(0) @db.Decimal(18, 2)
  currentYearUsage    Decimal         @default(0) @db.Decimal(18, 2)
  quarter             Int
  year                Int
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([userId, type, quarter, year])
  @@index([userId])
  @@map("transaction_limits")
}

model CashPickup {
  id                  String    @id @default(uuid())
  transactionId       String    @unique
  pickupLocation      String
  pickupLocationId    String?
  pickupState         String?
  pickupCity          String?
  pickupCode          String    @unique
  recipientName       String?
  recipientPhone      String?
  amount              Decimal   @db.Decimal(18, 2)
  currency            String
  status              String    @default("PENDING")
  scheduledPickupDate DateTime?
  scheduledPickupTime String?
  expiryDate          DateTime
  pickedUpAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([pickupCode])
  @@index([status])
  @@index([pickupState])
  @@index([pickupCity])
  @@map("cash_pickup")
}

model PrepaidCard {
  id               String    @id @default(uuid())
  transactionId    String    @unique
  cardNumber       String    @unique
  cardType         String
  amount           Decimal   @db.Decimal(18, 2)
  currency         String
  expiryDate       DateTime
  cvv              String
