// ========================================
// WALLET SERVICE MODELS
// ========================================

enum WalletEntryType {
  DEBIT
  CREDIT
}

enum WalletEntryStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model CustomerWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("NGN")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries WalletEntry[]

  @@index([userId])
  @@map("customer_wallets")
}

model WalletEntry {
  id             String            @id @default(uuid())
  walletId       String
  transactionId  String?           // Soft reference only — not a FK
  transactionRef String?           // Human-readable reference number
  sessionId      String?           // Providus session ID for traceability
  type           WalletEntryType
  amount         Decimal           @db.Decimal(18, 2)
  balanceBefore  Decimal           @db.Decimal(18, 2)
  balanceAfter   Decimal           @db.Decimal(18, 2)
  description    String?
  status         WalletEntryStatus @default(COMPLETED)
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Matching status (MATCHED / UNMATCHED)
  matchStatus          String?   // "MATCHED" | "UNMATCHED"

  // Linked transaction (manually linked by admin for unmatched entries)
  linkedTransactionId  String?
  linkReason           String?

  // Flagging
  isFlagged            Boolean   @default(false)
  flagReason           String?
  flaggedBy            String?
  flaggedAt            DateTime?

  // Refund
  refundStatus         String?   // "PENDING" | "COMPLETED" | "FAILED"
  refundedBy           String?
  refundedAt           DateTime?

  // Disbursement
  disbursementStatus   String?   // "PENDING" | "COMPLETED" | "FAILED"
  disbursedBy          String?
  disbursedAt          DateTime?

  wallet CustomerWallet @relation(fields: [walletId], references: [id])
  notes  WalletEntryNote[]

  workflowTemplateId     String?
  currentWorkflowStageId String?
  workflowTemplate       WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id])

  @@index([walletId])
  @@index([transactionId])
  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
  @@index([matchStatus])
  @@index([isFlagged])
  @@map("wallet_entries")
}

model WalletEntryNote {
  id        String   @id @default(uuid())
  entryId   String
  adminId   String
  note      String
  createdAt DateTime @default(now())

  entry WalletEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("wallet_entry_notes")
}

